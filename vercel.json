{
  "installCommand": "npm --prefix arjun_project/arjun_app/frontend ci",
  "buildCommand": "npm --prefix arjun_project/arjun_app/frontend run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "arjun_project/**",
      "excludeFiles": "arjun_project/arjun_app/frontend/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
