# Copy to .env for local use. On Vercel, set these in Project Settings > Environment Variables.
# Never commit the real .env file: it is listed in .gitignore.

# --- Required on Vercel -------------------------------------------------------
# A long random string: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# --- AI assistant (Google Gemini) ---------------------------------------------
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_S=9          # hard time limit; the assistant then answers from the FAQ

# --- SQL database: FAQs and support tickets (PostgreSQL, e.g. Neon or Vercel Postgres) ---
# Without it SQLite is used (a local file, or a throwaway file on Vercel).
DATABASE_URL=

# --- MongoDB: chat logs and feedback (e.g. MongoDB Atlas) ----------------------
MONGODB_URI=
# MONGODB_DB=foleycraft

# --- Optional -----------------------------------------------------------------
# WEATHER_DEFAULT_LAT=51.5074   # used when the visitor shares no location
# WEATHER_DEFAULT_LON=-0.1278
# DJANGO_DEBUG=0                # Vercel turns debug off by itself
# DJANGO_ALLOWED_HOSTS=example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# AUTO_MIGRATE=0                # skip creating tables on start
# Shared rate limit (Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
